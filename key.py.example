# -*- coding: utf-8 -*-
"""
MRAgent 上游脚本的凭据文件模板。

════════════════════════════════════════════════════════════════════════
为什么需要这个文件
════════════════════════════════════════════════════════════════════════
上游仓库里有 3 个实验脚本这样取凭据：

    step_2_test_STROBE_MR.py :  from key import AI_key
    step_9_test_out.py       :  from key import mr_key
    step_9_test_prompt.py    :  from key import AI_key, mr_key

但**上游仓库里没有 `key.py`，也没有 `.gitignore`**（`.idea/` 反而被提交了），
所以这些脚本 clone 下来直接跑必然是：

    ModuleNotFoundError: No module named 'key'

这解释了为什么它们只能算"实验脚本"，不是能开箱跑的生产入口。
本技能用 `scripts/run_mr.py` + `tools/*.py` 覆盖了同样的能力，
凭据一律走**环境变量**（不需要这个文件）；本文件只是给要跑上游原版脚本的人兜底。

用法
────
    cp key.py.example key.py     # Windows: copy key.py.example key.py
    # 然后编辑 key.py 填入自己的凭据

⚠️  `key.py` 已在 .gitignore 里排除，不会被提交；
    但本文件（key.py.example）**必须保持无真实凭据**，它会被提交。
"""

# OpenAI 或任何 OpenAI 兼容平台的 key。
# 对应环境变量：OPENAI_API_KEY / MRAGENT_AI_KEY
AI_key = "sk-REPLACE_ME"

# OpenGWAS JWT，从 https://api.opengwas.io/ 申请。
# 对应环境变量：OPENGWAS_JWT / MRAGENT_GWAS_TOKEN
mr_key = "REPLACE_ME"

# 可选：OpenAI 兼容平台的 base_url。
# 上游 demo 里用的是 https://api.gpt.ge/v1/ ，那是第三方中转，不是 OpenAI 官方。
base_url = "https://api.openai.com/v1"
